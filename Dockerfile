# Образ сервиса «Фенолог»: один контейнер, в котором собран интерфейс и лежит
# всё нужное для расчёта.
#
# Сборка двухэтапная. Node нужен только чтобы собрать фронтенд, и тащить его в
# итоговый образ незачем: из первого этапа во второй переезжает готовый каталог
# dist весом в полтора мегабайта, а не полтораста мегабайт инструментов.

# ---------------------------------------------------------------------------
# Этап 1. Сборка интерфейса
# ---------------------------------------------------------------------------
FROM node:24-alpine AS web

WORKDIR /web

# Манифесты копируются отдельно от исходников: слой с установленными пакетами
# пересобирается, только когда меняются сами зависимости, а не при каждой
# правке компонента.
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build


# ---------------------------------------------------------------------------
# Этап 2. Сервис
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS service

# PYTHONUNBUFFERED — чтобы прогресс сбора появлялся в `docker compose up` сразу,
# а не выплывал пачкой после завершения.
# PYTHONIOENCODING — журнал сервиса на русском, и без явной кодировки он
# превращается в вопросительные знаки.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Системные библиотеки. Колёса rasterio, pyproj и shapely приносят GDAL, PROJ и
# GEOS с собой, поэтому ставить их пакетами не нужно — не хватает только
# libexpat, от которой зависит PROJ, и корневых сертификатов для HTTPS-запросов
# к каталогам снимков.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libexpat1 curl \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Код и данные, нужные обеим точкам запуска — веб-сервису и batch-инференсу.
COPY src/ ./src/
COPY notebooks/ ./notebooks/

# models/ обязателен, и это не формальность: там климатология по типам культур.
# Без неё сервис поднимется и будет работать, но на полях без собственной
# истории (59 полигонов из 78) покажет пустой список периодов — и это выглядит
# как баг в детекции, а не как отсутствующий файл.
COPY models/ ./models/

# Обучающий набор нужен batch-инференсу: контрольные точки восстанавливаются с
# опорой на историю остальных полей. Постановка требует, чтобы `docker compose up`
# не ломал технический режим, поэтому данные едут в образ.
COPY data/ ./data/

# Каталог под выгрузки CLI. Копировать сюда reports/ целиком незачем — там
# девять мегабайт готовых картинок отчёта, — но `--output reports/anomalies.csv`
# должно писаться без предварительного mkdir от пользователя.
RUN mkdir -p reports

# Собранный интерфейс из первого этапа. Отдаётся тем же процессом FastAPI на том
# же порту — отдельный веб-сервер и настройка прокси не нужны.
COPY --from=web /web/dist ./web/dist

EXPOSE 8000

# Проверка живости бьёт в /health: он отвечает мгновенно и никуда не ходит, в
# отличие от /api/providers/health, который опрашивает внешние источники.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["python", "-m", "src.api", "--host", "0.0.0.0", "--port", "8000"]
